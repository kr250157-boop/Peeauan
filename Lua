-- ==================== 1. ฟังก์ชันบิน ====================
local flyActive = false
local flySpeed = 50
local bv, bg

local function toggleFly()
	flyActive = not flyActive
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	
	if flyActive then
		local hrp = character.HumanoidRootPart
		bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity = Vector3.new(0, 0, 0)
		bv.Parent = hrp
		
		bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		bg.CFrame = hrp.CFrame
		bg.Parent = hrp
		
		RunService.RenderStepped:Connect(function()
			if not flyActive then return end
			local camera = workspace.CurrentCamera
			local moveDirection = Vector3.new(0, 0, 0)
			
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				moveDirection = moveDirection + camera.CFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				moveDirection = moveDirection - camera.CFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				moveDirection = moveDirection - camera.CFrame.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				moveDirection = moveDirection + camera.CFrame.RightVector
			end
			
			bv.Velocity = moveDirection * flySpeed
			bg.CFrame = camera.CFrame
		end)
	else
		if bv then bv:Destroy() end
		if bg then bg:Destroy() end
	end
end

-- ==================== 2. ฟังก์ชันวิ่งไว ====================
local speedActive = false
local customSpeed = 50

local function toggleSpeed()
	speedActive = not speedActive
	local character = player.Character
	if character and character:FindFirstChild("Humanoid") then
		if speedActive then
			character.Humanoid.WalkSpeed = customSpeed
		else
			character.Humanoid.WalkSpeed = 16 -- ค่าเริ่มต้นของ Roblox
		end
	end
end

-- ==================== 3. ฟังก์ชันล่องหน ====================
local invisibleActive = false

local function toggleInvisible()
	invisibleActive = not invisibleActive
	local character = player.Character
	if not character then return end
	
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			part.Transparency = invisibleActive and 1 or 0
		elseif part:IsA("Accessory") then
			local handle = part:FindFirstChild("Handle")
			if handle then
				handle.Transparency = invisibleActive and 1 or 0
			end
		end
	end
	
	-- จัดการส่วนหน้า (Face)
	local head = character:FindFirstChild("Head")
	if head then
		local face = head:FindFirstChild("face")
		if face then
			face.Transparency = invisibleActive and 1 or 0
		end
	end
end

